---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	retriever(retriever)
	analyst(analyst)
	bump_loop(bump_loop)
	answer(answer)
	__end__([<p>__end__</p>]):::last
	__start__ --> retriever;
	analyst --> bump_loop;
	bump_loop -.-> answer;
	bump_loop -.-> retriever;
	retriever --> analyst;
	answer --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
